{
  "name": "tempest-launcher",
  "version": "1.0.0",
  "description": "Tempest Factions — custom Minecraft Forge 1.16.5 launcher for the Tempest Factions PvP server",
  "main": "main.js",
  "author": "Tempest Factions",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "hash": "node scripts/hash.js",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "prismarine-nbt": "^2.6.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tempestfactions.launcher",
    "productName": "Tempest Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
